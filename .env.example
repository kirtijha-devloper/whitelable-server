# Copy this file to `.env` and fill in the real values.
# Keep secrets out of source control.

# ------------------------------------------------------------------------------
# Core app
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
SYNC_DB=false
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000
DL_TOKEN_TTL_MINUTES=120

# ------------------------------------------------------------------------------
# Database
# Required by runtime and Sequelize CLI.
# ------------------------------------------------------------------------------
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pos_abheepay_local
DB_USER=postgres
DB_PASS=your_db_password

# Legacy alias supported in some paths:
# DB_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# Redis / queues
# In development, queues auto-disable when REDIS_* is not set.
# Set DISABLE_QUEUES=true to force-disable workers locally.
# REDIS_URL overrides REDIS_HOST/REDIS_PORT when provided.
# ------------------------------------------------------------------------------
DISABLE_QUEUES=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Cloudinary uploads
# Needed for merchant, franchise, and user document uploads.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Mail / email OTP
# Preferred keys. The code also supports legacy GMAIL_USER and
# GMAIL_APP_PASSWORD fallbacks if needed.
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@abheepay.com

# ------------------------------------------------------------------------------
# SMS / OTP (Bulk9)
# ------------------------------------------------------------------------------
# Required for login OTP SMS.
# Paste your real Bulk9 API key below. Keep the sender ID matched to your DLT setup.

BULK9_API_KEY=your_bulk9_api_key
BULK9_SENDER_ID=ABHEPY

# ------------------------------------------------------------------------------
# Razorpay / webhook auth
# Both credential pairs are expected by the webhook middleware.
# ------------------------------------------------------------------------------
WEBHOOK_USERNAME=razorpay
WEBHOOK_PASSWORD=replace_with_webhook_password
WEBHOOK_USERNAME_EVERLIFE=razorpay
WEBHOOK_PASSWORD_EVERLIFE=replace_with_everlife_webhook_password

# ------------------------------------------------------------------------------
# BranchX payout integration
# ------------------------------------------------------------------------------
BRANCHX_API_TOKEN=

# ------------------------------------------------------------------------------
# CredXPay integration
# CREDXPAY_WEBHOOK_IPS should be a comma-separated list.
# Example: 1.2.3.4,5.6.7.8
# ------------------------------------------------------------------------------
CREDXPAY_BASE_URL=
CREDXPAY_API_KEY=
CREDXPAY_WEBHOOK_IPS=

# ------------------------------------------------------------------------------
# InstantPay / iPay / BBPS / KYC
# ------------------------------------------------------------------------------
IPAY_AUTH_CODE=
IPAY_CLIENT_ID=
IPAY_CLIENT_SECRET=
IPAY_ENDPOINT_IP=
IPAY_OUTLET_ID=
IPAY_KEY=

# ------------------------------------------------------------------------------
# BillAvenue
# ------------------------------------------------------------------------------
BILLAVENUE_API_KEY=
BILLAVENUE_ACCESS_CODE=
BILLAVENUE_INSTITUTE_ID=
BILLAVENUE_API_VER=1.0
BILLAVENUE_API_URL=https://stgapi.billavenue.com/

# ------------------------------------------------------------------------------
# BBPS credit-card payment
# Encryption key must be 32 bytes and IV must be 16 bytes for AES-256-CBC.
# ------------------------------------------------------------------------------
BBPS_ACCESS_CODE=
BBPS_INSTITUTE_ID=
ENCRYPTION_KEY=replace_with_32_byte_key
ENCRYPTION_IV=replace_with_16_byte_iv

# ------------------------------------------------------------------------------
# Vimo payout integration
# Use VIMO_ENCRYPTDECRYPT_KEY as the primary value. The code also accepts
# VIMO_ENCRYPT_KEY as a fallback alias.
# ------------------------------------------------------------------------------
VIMO_BASE_URL=
VIMO_SECRET_KEY=
VIMO_SALT_KEY=
VIMO_ENCRYPTDECRYPT_KEY=
# VIMO_ENCRYPT_KEY=
VIMO_USER_ID=
VIMO_TIMEOUT_MS=15000
VIMO_TOKEN_TTL_MS=600000
VIMO_DEFAULT_SERVICE_CHARGE=0
VIMO_CRYPTO_KEY_SOURCE=secretKey
VIMO_CRYPTO_IV_SOURCE=saltKey
VIMO_CRYPTO_KEY_ENCODING=utf8
VIMO_CRYPTO_IV_ENCODING=utf8
VIMO_GCM_IV_BYTES=12

# ------------------------------------------------------------------------------
# SDDS / legacy payment flow
# ------------------------------------------------------------------------------
TPIN=

# ------------------------------------------------------------------------------
# Dev / test / seed helpers
# ------------------------------------------------------------------------------
TEST_MAIL_RECIPIENT=dev@example.com
TEST_MOBILE_PREFIX=7
SEED_USER_ID=
PARTNER_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# MeroRecharge (Payout-M-X) integration
# ------------------------------------------------------------------------------
MX_BASE_URL=https://merorecharge.com
MX_PAYOUT_TOKEN=replace_with_real_x_payout_token
MX_TRANSACTION_PIN=replace_with_real_mero_transaction_pin
ENABLE_MX_PENDING_CRON=true
MX_PENDING_CRON_SCHEDULE=30 */2 * * * *

# ------------------------------------------------------------------------------
# NDIA5 Payout integration
# ------------------------------------------------------------------------------
NDIA5_BASE_URL=https://api.uat.ndia5.com
NDIA5_USERNAME=your_ndia5_username
NDIA5_PASSWORD=your_ndia5_password
NDIA5_SALT=your_ndia5_salt
ENABLE_NDIA5_PENDING_CRON=true
NDIA5_PENDING_CRON_SCHEDULE=0 */3 * * * *

# NDIA5 Shared Token Proxy (used by ndia5Payout.service.js login() via /api/shared/ndia5-token)
# These header credentials are validated by the shared proxy endpoint
NDIA5_CLIENT_ID=your_ndia5_client_id
NDIA5_API_KEY=your_ndia5_api_key
# Override this URL if running locally (e.g. http://localhost:5000/api/shared/ndia5-token)
NDIA5_TOKEN_PROXY_URL=https://api.abheepay.com/api/shared/ndia5-token
